{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "rootDir": "./src"
  },
  "include": [
    "src/index.ts",
    "src/table.ts",
    "src/kanban.ts",
    "src/ai.ts",
    "src/components/table/**/*",
    "src/components/kanban/**/*",
    "src/components/ai/**/*",
    "src/components/shared/**/*",
    "src/components/ui/**/*",
    "src/lib/cn.ts",
    "src/lib/utils.ts"
  ]
}
