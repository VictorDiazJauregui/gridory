{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "rootDir": "./src"
  },
  "include": [
    "src/index.ts",
    "src/table.ts",
    "src/kanban.ts",
    "src/ai.ts",
    "src/auth.ts",
    "src/segmented-control.ts",
    "src/country-select.ts",
    "src/phone-input.ts",
    "src/components/table/**/*",
    "src/components/kanban/**/*",
    "src/components/ai/**/*",
    "src/components/auth/**/*",
    "src/components/segmented-control/**/*",
    "src/components/country-select/**/*",
    "src/components/phone-input/**/*",
    "src/components/shared/**/*",
    "src/components/ui/**/*",
    "src/lib/cn.ts"
  ]
}
