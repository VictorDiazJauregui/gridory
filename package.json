{
  "name": "gridory",
  "version": "1.0.0",
  "private": true,
  "description": "React components for data-heavy apps: table, kanban and AI assistant that emit events instead of mutating your data.",
  "keywords": [
    "react",
    "react-components",
    "component-library",
    "ui-components",
    "design-system",
    "data-table",
    "datatable",
    "datagrid",
    "kanban",
    "kanban-board",
    "drag-and-drop",
    "ai-assistant",
    "ai-chat",
    "typescript",
    "radix-ui",
    "tanstack-table",
    "admin-dashboard",
    "back-office"
  ],
  "license": "MIT",
  "author": "Victor Díaz Jáuregui (https://github.com/VictorDiazJauregui)",
  "homepage": "https://github.com/VictorDiazJauregui/gridory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VictorDiazJauregui/gridory.git"
  },
  "bugs": {
    "url": "https://github.com/VictorDiazJauregui/gridory/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "files": [
    "dist",
    "tailwind-preset.js"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./table": {
      "types": "./dist/types/table.d.ts",
      "import": "./dist/table.js"
    },
    "./kanban": {
      "types": "./dist/types/kanban.d.ts",
      "import": "./dist/kanban.js"
    },
    "./ai": {
      "types": "./dist/types/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./styles.css": "./dist/gridory.css",
    "./tailwind-preset": "./tailwind-preset.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run typecheck && npm run build:lib && npm run build:types",
    "audit:styles": "node scripts/audit-legacy.mjs && node scripts/audit-classes.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "openai": "^6.3.0",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/geist": "^5.2.8",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shadcn": "^4.1.0",
    "tailwindcss": "^3.4.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  }
}
